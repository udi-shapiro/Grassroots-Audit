    "publication_assertions_python": "from pathlib import Path\nimport re, sys\nafter = Path(\"audit/calculus/contracts.md\").read_text()\nstart = after.index(\"## Calculus (12) and (13) against GSC (19), November 2026\")\nend = after.index(\"## Findings and responses\", start)\nassert after[:start] + after[end:] == sys.stdin.read()\nfor path in re.findall(r'\\]\\((\\.review-files/[^)]+)\\)', after[start:end]):\n    assert (Path(\"audit/calculus\") / path).is_file(), path\nassert len(re.findall(r'\\]\\((\\.review-files/[^)]+)\\)', after[start:end])) == 2\nknowledge = Path(\"calculus/contracts/Knowledge/full-schemas.txt\").read_text()\nacts = {n: re.search(rf'^Knowledge:{n} .*?:(.*?)<-', knowledge, re.M)[1] for n in (2, 3)}\nassert all('knows(' in head and 'met(' not in head for head in acts.values())\nrehearsal = Path(\"calculus/contracts/Rehearsal-Rooms/full-schemas.txt\").read_text()\nretire = [line for line in rehearsal.splitlines() if line.startswith('Guardians:5') and 'Retire:' in line]\nassert len(retire) == 2\nassert any('retired(Orga)' in x and '~officer(' in x and 'deciders(Orga)' in x for x in retire)\nassert any('retired(Wendy)' in x and '~guardian(' in x and 'deciders(Wendy)' in x for x in retire)\nprint(\"Report insertion and both links verified. Both Knowledge heads and the two Rehearsal Retire clauses match the published review.\")",
