  "relevant_patches": [
    {
      "path": "programs/apps/compile.sh",
      "patch": "@@ -12,7 +12,7 @@\n #   gai    gai       programs/gai/GAI.glp\n #   gc     gc        programs/currencies/coins/GC.glp\n #   gb     gb        programs/currencies/bonds/GB.glp\n-#   gff    gff       programs/gff/GFF.glp\n+#   gff    gff_i     programs/gff/GFF-I.glp   (GFF-I, which restricts GFF, the abstract contract, and is the one compiled: programs/gff/GFF-I.txt)\n #\n # The steps are cascade.sh's 1, 2 and 4: the contract, contract_named/2, from the owner's file; the checker's verdict on it, programs/gsc's check/2; and the compiler, programs/vglp/cva/compiler's compile/5, on the contract, its verdict, its introduction predicate, introduction_named/2 where the owner's file names one and no_introduction otherwise, and its pragmas, the words its app shows, read from the NAME.txt beside the owner's file and from those of the contracts it extends by programs/vglp/cva/compiler/pragmas.sh (vGLP, Section 5.4, \"The contract's words\"), each act the schema its button names (GSC, Section 2).  What the compiler prints between its lines \"%% compile begin\" and \"%% compile end\" is the platform.\n #\n@@ -33,7 +33,7 @@ contract_of() { # contract_of <app> ; the checker's name of its contract\n         gai) echo gai ;;\n         gc) echo gc ;;\n         gb) echo gb ;;\n-        gff) echo gff ;;\n+        gff) echo gff_i ;;\n     esac\n }\n file_of() { # file_of <app> ; the owner's file that holds its contract\n@@ -45,7 +45,7 @@ file_of() { # file_of <app> ; the owner's file that holds its contract\n         gai) echo \"$GLP_DIR/programs/gai/GAI.glp\" ;;\n         gc) echo \"$GLP_DIR/programs/currencies/coins/GC.glp\" ;;\n         gb) echo \"$GLP_DIR/programs/currencies/bonds/GB.glp\" ;;\n-        gff) echo \"$GLP_DIR/programs/gff/GFF.glp\" ;;\n+        gff) echo \"$GLP_DIR/programs/gff/GFF-I.glp\" ;;\n     esac\n }\n "
    },
    {
      "path": "test/run_all_tests.sh",
      "patch": "@@ -8737,7 +8737,7 @@ check \"APPS gsnp agents: the run suspends, no agent left with an own transaction\n check_not \"APPS gsnp agents: ... and is not stopped at the limit\" \"capped\" \"$apps_gsnp_ag\"\n \n # GFF's app, programs/apps/gff: the same host on GFF's platform (programs/gff/GFF.glp and GFF.txt), its wrapper the same file as GSG's; GFF's play (Code_inbox.md, GFF #1 Cowork, 2026-10-27 16:34 UTC, with its revisions of 17:21, 18:39 and 19:2x and 20:25 UTC), five executions over four conversations, alice's with bob, bob's with carol, carol's with dave and dave's with eve (play_feeds): each two friends meet and befriend (GKK:2, GSG:1); alice posts two items (GFF:1); each two friends follow each other (GFF:2, friends_follow); once both items have reached bob he introduces alice to carol (GKK:3); carol decides to follow alice (GFF:2, follow), her machine following her through bob and asking her friends (through_friend, ask; GFF:3), and introduces her to dave; dave likewise through carol, and eve through dave; once eve follows alice, alice posts a third item, which reaches eve signed by alice, bob, carol and dave, once each (GFF:4); once it has, carol ends her following; once she has, alice posts a fourth, which reaches bob and not carol, dave or eve.  Each \"once\" across two persons is the play's, a watcher on one screen giving the other person the rest of their script (plays.glp).\n-check \"APPS gff: platform.vglp is what vGLP's compiler prints from GFF.glp\" \"^gff/platform.vglp: as printed$\" \"$apps_print\"\n+check \"APPS gff: platform.vglp is what vGLP's compiler prints from GFF-I.glp\" \"^gff/platform.vglp: as printed$\" \"$apps_print\"\n if cmp -s \"$GLP_DIR/programs/apps/gsg/miniapp.glp\" \"$GLP_DIR/programs/apps/gff/miniapp.glp\"; then\n     _check_pass \"APPS gff: miniapp.glp is the same file as GSG's app's\"\n else"
    }
  ],
  "interpretation": "Currency and GSA source/artifacts unchanged. GFF compile input changed to GFF-I; its check label changes. KNOWN_RED_CHECKS block unchanged. No GFF rerun claimed."
